<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tecnologias | Conecta Futuro</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      line-height: 1.6;
    }

    /* ===== HEADER ===== */
    header {
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid #1e293b;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.35rem;
      font-weight: 700;
      color: #38bdf8;
      text-decoration: none;
    }

    .logo span {
      color: #f1f5f9;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 1.75rem;
    }

    nav a {
      color: #94a3b8;
      text-decoration: none;
      font-weight: 500;
      font-size: 0.95rem;
      transition: color 0.2s;
    }

    nav a:hover,
    nav a.active {
      color: #38bdf8;
    }

    .btn-nav {
      background: linear-gradient(135deg, #0ea5e9, #0284c7);
      color: white !important;
      padding: 0.55rem 1.25rem;
      border-radius: 8px;
      font-weight: 600;
    }

    .btn-nav:hover {
      opacity: 0.9;
    }

    .menu-toggle {
      display: none;
      background: none;
      border: none;
      color: #e2e8f0;
      font-size: 1.5rem;
      cursor: pointer;
    }

    /* ===== HERO ===== */
    .hero-tech {
      max-width: 900px;
      margin: 0 auto;
      padding: 5rem 1.5rem 3rem;
      text-align: center;
    }

    .section-label {
      display: inline-block;
      background: #1e293b;
      color: #38bdf8;
      padding: 0.4rem 1rem;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 500;
      margin-bottom: 1.25rem;
      border: 1px solid #334155;
      letter-spacing: 0.5px;
    }

    .hero-tech h1 {
      font-size: clamp(1.9rem, 4.5vw, 2.8rem);
      font-weight: 800;
      margin-bottom: 1rem;
      color: #f1f5f9;
      line-height: 1.2;
    }

    .hero-tech h1 span {
      color: #38bdf8;
    }

    .hero-tech p {
      font-size: 1.15rem;
      color: #94a3b8;
      max-width: 560px;
      margin: 0 auto;
    }

    /* ===== CARDS ===== */
    .careers {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem 5rem;
    }

    .career-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .career-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 14px;
      padding: 1.75rem;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }

    .career-card:hover {
      transform: translateY(-4px);
      border-color: #0ea5e9;
      box-shadow: 0 8px 25px rgba(14, 165, 233, 0.15);
    }

    .career-card .icon {
      font-size: 2.2rem;
      margin-bottom: 1rem;
      display: block;
    }

    .career-card h3 {
      font-size: 1.25rem;
      margin-bottom: 0.6rem;
      color: #f1f5f9;
    }

    .career-card p {
      color: #94a3b8;
      font-size: 0.95rem;
    }

    /* ===== FOOTER ===== */
    footer {
      border-top: 1px solid #1e293b;
      padding: 2rem 1.5rem;
      text-align: center;
      color: #64748b;
      font-size: 0.9rem;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
      nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #0f172a;
        border-bottom: 1px solid #1e293b;
        flex-direction: column;
        padding: 1rem 1.5rem 1.5rem;
        gap: 0.75rem;
        z-index: 99;
      }

      nav.ativo {
        display: flex;
      }

      nav a {
        padding: 0.6rem 0;
        width: 100%;
        border-bottom: 1px solid #1e293b;
      }

      nav a:last-child {
        border-bottom: none;
        margin-top: 0.5rem;
        text-align: center;
      }

      .menu-toggle {
        display: block;
      }

      .hero-tech {
        padding: 3.5rem 1.25rem 2rem;
      }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header>
    <div class="nav-container">
      <a href="index.html" class="logo">⚡ <span>Conecta Futuro</span></a>

      <button class="menu-toggle" aria-label="Menu">☰</button>

      <nav>
        <a href="index.html">Início</a>
        <a href="index.html#trilhas">Trilhas</a>
        <a href="tecnologias.html" class="active">Tecnologias</a>
        <a href="sobre.html">Sobre</a>
        <a href="index.html#comecar" class="btn-nav">Começar agora</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero-tech">
    <span class="section-label">EXPLORE AS POSSIBILIDADES</span>
    <h1>Onde a tecnologia <span>pode levar você?</span></h1>
    <p>Conheça algumas das áreas que fazem parte do mercado de tecnologia.</p>
  </section>

  <!-- CARDS -->
  <section class="careers">
    <div class="career-grid">

      <div class="career-card">
        <span class="icon">💻</span>
        <h3>Programação</h3>
        <p>Criação de sites, sistemas e aplicativos.</p>
      </div>

      <div class="career-card">
        <span class="icon">🎨</span>
        <h3>UX/UI</h3>
        <p>Criação de experiências e interfaces digitais.</p>
      </div>

      <div class="career-card">
        <span class="icon">📊</span>
        <h3>Dados</h3>
        <p>Transformação de informações em conhecimento.</p>
      </div>

      <div class="career-card">
        <span class="icon">🔐</span>
        <h3>Cibersegurança</h3>
        <p>Proteção de sistemas, dados e usuários.</p>
      </div>

      <div class="career-card">
        <span class="icon">📱</span>
        <h3>Marketing Digital</h3>
        <p>Estratégias para comunicação no ambiente digital.</p>
      </div>

      <div class="career-card">
        <span class="icon">☁️</span>
        <h3>Cloud & TI</h3>
        <p>Infraestrutura, redes e serviços digitais.</p>
      </div>

    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <p>© 2026 Conecta Futuro • Projeto de Extensão • Análise e Desenvolvimento de Sistemas</p>
  </footer>

  <script>
    const menuToggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('nav');

    menuToggle.addEventListener('click', () => {
      nav.classList.toggle('ativo');
      menuToggle.textContent = nav.classList.contains('ativo') ? '✕' : '☰';
    });

    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('ativo');
        menuToggle.textContent = '☰';
      });
    });
  </script>

</body>
</html>
